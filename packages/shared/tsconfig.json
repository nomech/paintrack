{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "declaration": true,
        "rootDir": ".",
        "outDir": "./dist"
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "*.ts"
    ]
}
