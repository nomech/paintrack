{
	"name": "paintrack-backend",
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"test": "vitest run",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"db:generate": "npx drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate",
		"db:studio": "npx drizzle-kit studio",
		"db:seed": "tsx src/db/seed.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@paintrack/shared": "workspace:*",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.3",
		"hono-rate-limiter": "^0.5.3",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
