{
	"name": "paintrack-backend",
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"test": "vitest run",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"db:generate": "npx drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate",
		"db:studio": "npx drizzle-kit studio",
		"db:seed": "tsx src/db/seed.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.3",
		"@paintrack/shared": "workspace:*",
		"@supabase/supabase-js": "^2.117.2",
		"dotenv": "^18.0.4",
		"drizzle-orm": "^0.45.3",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.11",
		"hono-rate-limiter": "^0.5.4",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	}
}
